+fn is_agent_dispatch(name: &str) -> bool {
+    let name = name.strip_prefix("functions.").unwrap_or(name);
+    let name = name
+        .strip_prefix("collaboration.")
+        .or_else(|| name.strip_prefix("collaboration"))
+        .or_else(|| name.strip_prefix("multi_agent_v1."))
+        .unwrap_or(name);
+    matches!(
+        name,
+        "spawn_agent"
+            | "Agent"
+            | "send_message"
+            | "send_input"
+            | "followup_task"
+            | "resume_agent"
+            | "send_message_to_thread"
+            | "mcp__codex_app__send_message_to_thread"
+            | "mcp__codex_app.send_message_to_thread"
+    )
+}
+
+fn is_native_status_message(name: &str) -> bool {
+    matches!(
+        name,
+        "send_message"
+            | "collaborationsend_message"
+            | "collaboration.send_message"
+            | "functions.send_message"
+    )
+}
