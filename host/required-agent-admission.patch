+fn host_bundled_desktop_reads(
+    config: &Config,
+    server_name: &str,
+    server: Option<&codex_mcp::ResolvedMcpServer>,
+) -> bool {
+    let Some(server) = server.filter(|_| server_name == "codex_app") else {
+        return false;
+    };
+    let codex_mcp::McpServerSource::Plugin(plugin) = server.source() else {
+        return false;
+    };
+    if plugin.plugin_id() != "codex-app-tools@openai-bundled"
+        || plugin.is_agent_plugin()
+        || !server.config().is_local_environment()
+    {
+        return false;
+    }
+    let Some(root) = plugin
+        .host_root()
+        .and_then(|root| root.to_path_buf().canonicalize().ok())
+    else {
+        return false;
+    };
+    // Use the same canonical form as host_root, including Windows verbatim prefixes.
+    let Ok(home) = std::fs::canonicalize(config.codex_home.as_path()) else {
+        return false;
+    };
+    let cache = home.join("plugins/cache/openai-bundled/codex-app-tools");
+    // The source and root are captured by native plugin discovery, never by the MCP server.
+    // Do not grant a selected package, a same-name manual registration, or a redirected cache root.
+    if cache.canonicalize().ok().as_ref() != Some(&cache) || root.parent() != Some(cache.as_path())
+    {
+        return false;
+    }
+    let codex_config::McpServerTransportConfig::Stdio {
+        command,
+        args,
+        env,
+        env_vars,
+        cwd,
+    } = &server.config().transport
+    else {
+        return false;
+    };
+    let mut inherited = HashSet::new();
+    let mut pipe_count = 0;
+    for var in env_vars {
+        let name = var.name();
+        let key = if cfg!(windows) {
+            name.to_ascii_lowercase()
+        } else {
+            name.to_string()
+        };
+        if var.is_remote_source() || !inherited.insert(key) {
+            return false;
+        }
+        if name.eq_ignore_ascii_case("CODEX_APP_TOOLS_PIPE_PATH") {
+            if name != "CODEX_APP_TOOLS_PIPE_PATH" {
+                return false;
+            }
+            pipe_count += 1;
+        }
+    }
+    if cwd
+        .as_ref()
+        .and_then(|cwd| Path::new(cwd.as_str()).canonicalize().ok())
+        .as_ref()
+        != Some(&root)
+        || pipe_count != 1
+        || env.as_ref().is_some_and(|env| {
+            env.iter().any(|(key, value)| {
+                key != "CODEX_APP_TOOLS_DEFERRED" || !matches!(value.as_str(), "0" | "1")
+            })
+        })
+    {
+        return false;
+    }
+    let launcher = if cfg!(windows) {
+        "launch_codex_app_tools_mcp.cmd"
+    } else {
+        "launch_codex_app_tools_mcp"
+    };
+    let script = root.join("server.mjs");
+    let launcher_path = root.join("scripts").join(launcher);
+    if !script.is_file()
+        || !launcher_path.is_file()
+        || script.canonicalize().ok().as_ref() != Some(&script)
+        || launcher_path.canonicalize().ok().as_ref() != Some(&launcher_path)
+    {
+        return false;
+    }
+    if cfg!(windows) {
+        command.eq_ignore_ascii_case("cmd.exe")
+            && args
+                == &[
+                    "/d",
+                    "/s",
+                    "/c",
+                    "call",
+                    "./scripts/launch_codex_app_tools_mcp.cmd",
+                    "./server.mjs",
+                ]
+    } else {
+        let command = Path::new(command);
+        let command = if command.is_absolute() {
+            command.to_path_buf()
+        } else {
+            root.join(command)
+        };
+        command.canonicalize().ok() == Some(launcher_path) && args == &["./server.mjs"]
+    }
+}
