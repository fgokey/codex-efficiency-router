+                    ev_custom_tool_call(
+                        "retained-inventory",
+                        "exec",
+                        "text(await tools.completion_check({operation:'inspect'}));",
+                    ),
+                    ev_completed("retained-inspect"),
+                ]),
+                sse(vec![
+                    ev_assistant_message("after-boundary", "Still only local work"),
+                    ev_completed("e2"),
+                ]),
+                sse(vec![
+                    ev_custom_tool_call(
+                        "after-boundary-check",
+                        "exec",
+                        &parent_check_script("done"),
+                    ),
+                    ev_completed("e3"),
+                ]),
+                sse(vec![
+                    ev_assistant_message("after-boundary-done", "Reconciled"),
+                    ev_completed("e4"),
+                ]),
+            ]);
+        }
+        let responses = mount_sse_sequence(&server, scripted).await;
+        let mut builder = test_codex().with_config(|config| {
+            config.agent_admission_hook = Some("required-admission".to_string());
