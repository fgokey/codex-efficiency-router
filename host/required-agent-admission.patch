+                tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+            }
+        })
+        .await?;
+        let (namespace, raw_tool) = if v2 {
+            (
+                test.config.multi_agent_v2.tool_namespace.as_deref(),
+                "followup_task",
+            )
+        } else {
+            (Some("multi_agent_v1"), "send_input")
+        };
+        let raw_args = serde_json::json!({"target":astra_id,"message":"continue"}).to_string();
+        let raw_call = match namespace {
+            Some(namespace) => ev_function_call_with_namespace(
+                "astra-raw-continue",
+                namespace,
+                raw_tool,
+                &raw_args,
+            ),
+            None => ev_function_call("astra-raw-continue", raw_tool, &raw_args),
+        };
+        parent_queue.lock().unwrap().extend([
+            sse(vec![
+                ev_response_created("astra-raw-continue"),
+                raw_call,
+                ev_completed("astra-raw-continue"),
+            ]),
+            sse(vec![
+                ev_assistant_message("astra-raw-done", "checked"),
+                ev_completed("astra-raw-end"),
+            ]),
+        ]);
+        test.submit_turn("reject raw loaded Astra continuation")
+            .await?;
+        let raw_result = output(
+            &server.received_requests().await.unwrap(),
+            "astra-raw-continue",
+        )?;
+        assert!(
+            raw_result.contains("requires admitted_agent_task"),
+            "{raw_result}"
+        );
+        for (call, tool, args, reason) in [
+            (
+                "astra-bare-continue",
+                "admitted_agent_task",
+                serde_json::json!({"operation":"assign","target":astra_id,"body":"continue"}),
+                "receipts/continue grant no exemption",
+            ),
+            (
+                "astra-changed-body",
+                "admitted_agent_task",
+                serde_json::json!({"operation":"assign","target":astra_id,
+                    "body":format!("{astra_work_prefix}{astra_message} Extra work.")}),
+                "assignment target/body/identity/policy mismatch",
+            ),
+        ] {
+            turn(&parent_queue, call, tool, args);
+            test.submit_turn("reject old fixture Astra continuation")
+                .await?;
+            let result = output(&server.received_requests().await.unwrap(), call)?;
+            assert!(result.contains(reason), "{result}");
+        }
+        let (header, readable_reasons) = astra_work_prefix
+            .split_once('\n')
+            .context("assignment header separator")?;
+        let header = header
+            .strip_prefix("CER assignment (caller evidence): ")
+            .context("assignment prefix")?;
+        let mut stale: Value = serde_json::from_str(header.trim())?;
+        stale["admission"]["purpose"] = Value::String("reuse".to_string());
+        turn(
+            &parent_queue,
+            "astra-stale-reuse",
+            "admitted_agent_task",
+            serde_json::json!({
+            "operation":"assign","target":astra_id,
+            "body":format!("CER assignment (caller evidence): {stale}\n{readable_reasons}{astra_message}")}),
+        );
+        test.submit_turn("reject stale fixture Astra admission")
+            .await?;
+        let stale_result = output(
+            &server.received_requests().await.unwrap(),
+            "astra-stale-reuse",
+        )?;
+        assert!(
+            stale_result.contains("fresh purpose=new_unit"),
+            "{stale_result}"
+        );
+        assert!(child_queue.lock().unwrap().is_empty());
+        assert!(matches!(
+            astra_child.agent_status().await,
+            codex_protocol::protocol::AgentStatus::Completed(_)
+        ));
+        assert_eq!(test.codex.config_snapshot().await.model, "gpt-6-astra");
+    }
+    Ok(())
+}
