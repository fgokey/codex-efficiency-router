+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn admission_host_code_mode_cannot_bypass_astra_execution_boundary() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    for v2 in [false, true] {
+        let server = responses::start_mock_server().await;
+        let fixture = tempfile::TempDir::new()?;
+        let marker = fixture.path().join("nested-shell-write");
+        let source = fixture.path().join("source.txt");
+        fs::write(&source, "native nested reader evidence\n")?;
+        let command = format!("git init --quiet \"{}\"", marker.display());
+        let code = format!(
+            "for (const [name,args] of [['exec_command',{{cmd:{}}}],['apply_patch','*** Begin Patch\\n*** Add File: forbidden.txt\\n+bad\\n*** End Patch'],['write_stdin',{{session_id:123456,chars:'write'}}]]) {{ try {{ text(await tools[name](args)); }} catch (e) {{ text(String(e)); }} }} text(await tools.read_only({{path:{}}}));",
+            serde_json::to_string(&command)?,
+            serde_json::to_string(&source)?,
+        );
+        let mut info = bundled_models_response()?
+            .models
+            .into_iter()
+            .find(|info| info.slug == "gpt-5.5")
+            .expect("bundled tool-capable model");
+        info.slug = "gpt-6-astra".to_string();
+        let (_test, result) = run_code_mode_turn_with_model_and_config(
+            &server,
+            "verify nested boundary",
+            &code,
+            "gpt-6-astra",
+            move |config| {
+                config.model_catalog =
+                    Some(codex_protocol::openai_models::ModelsResponse { models: vec![info] });
+                config.agent_admission_hook = Some("required-admission".to_string());
+                config.features.enable(Feature::Collab).unwrap();
+                if v2 {
+                    config.features.enable(Feature::MultiAgentV2).unwrap();
+                } else {
+                    config.features.disable(Feature::MultiAgentV2).unwrap();
+                }
+            },
+        )
+        .await?;
+        let output = result
+            .single_request()
+            .custom_tool_call_output("call-1")
+            .to_string();
+        assert_eq!(
+            output.matches("Read-only agent execution boundary").count(),
+            3,
+            "{output}"
+        );
+        assert!(output.contains("native nested reader evidence"), "{output}");
+        assert!(!marker.exists());
+    }
+    Ok(())
+}
