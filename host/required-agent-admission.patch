+#[cfg(test)]
+mod parent_completion_tests {
+    use super::*;
+    use serde_json::json;
+
+    fn open() -> ParentWorkState {
+        let mut state = ParentWorkState::default();
+        state
+            .apply(
+                &json!({"operation":"begin","accepted_scope":"Finish the ownership work",
+            "required_work":[{"id":"ownership","requirement":"Resolve retained ownership"}]}),
+                "turn-1",
+            )
+            .unwrap();
+        state
+    }
+
+    fn check(state: &mut ParentWorkState, turn: &str, status: &str) -> Result<bool, String> {
+        state.apply(&json!({"operation":"check","task_revision":state.task_revision,
+            "event_version":state.event_version,"work":[{"id":"ownership","status":status,
+            "evidence":"current fixture evidence","missing_resource":"capture access",
+            "affected_scope":"runtime measurement","external_action":"grant the capture permission"}]}), turn)
+    }
+
+    #[test]
+    fn actionable_or_stale_check_cannot_reuse_an_old_receipt() {
+        let mut state = open();
+        check(&mut state, "turn-1", "done").unwrap();
+        assert!(state.receipt_current("turn-1"));
+        assert!(
+            check(&mut state, "turn-1", "actionable")
+                .unwrap_err()
+                .contains("actionable")
+        );
+        assert!(!state.receipt_current("turn-1"));
+        assert!(state.stop("turn-1").unwrap().is_some());
+        check(&mut state, "turn-1", "done").unwrap();
+        assert!(
+            state
+                .apply(
+                    &json!({"operation":"check","task_revision":0,"event_version":0,"work":[]}),
+                    "turn-1"
+                )
+                .is_err()
+        );
+        assert!(!state.receipt_current("turn-1"));
+    }
+
+    #[test]
+    fn completion_block_and_checkpoint_have_distinct_lifetimes() {
+        let mut state = open();
+        check(&mut state, "turn-1", "external_block").unwrap();
+        state.finish("turn-1").unwrap();
+        assert!(state.active(), "blocked work must survive a final response");
+        let mut restored = ParentWorkState::default();
+        restored.restore(state.checkpoint());
+        assert_eq!(restored.required, state.required);
+        assert!(
+            restored.stop("turn-2").unwrap().is_some(),
+            "old-turn receipt is not current"
+        );
+        check(&mut restored, "turn-2", "done").unwrap();
+        restored.finish("turn-2").unwrap();
+        assert!(!restored.active());
+        assert!(restored.stop("standalone-question").unwrap().is_none());
+    }
+
+    fn independent_answer(state: &mut ParentWorkState, turn: &str) -> JsonValue {
+        state.request(&json!({"operation":"check","turn_scope":"independent_answer",
+            "task_revision":state.task_revision,"event_version":state.event_version,
+            "rationale":"The user asks for a standalone explanation, not continued engineering."}), turn)
+    }
+
+    #[test]
+    fn independent_answer_retains_every_requirement_and_full_completion_still_clears_them() {
+        let mut state = open();
+        check(&mut state, "turn-1", "external_block").unwrap();
+        state.finish("turn-1").unwrap();
+        let scope = state.scope.clone();
