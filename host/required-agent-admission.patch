+
+    fn allows_bounded_parent_read(&self, invocation: &ToolInvocation) -> bool {
+        // Native client-supplied capabilities retain their transport-specific identity check.
+        let capability = match (
+            self.tool_name.namespace.as_deref(),
+            self.tool_name.name.as_str(),
+        ) {
+            (None | Some("functions"), "mcp__codex_app__read_thread")
+            | (Some("mcp__codex_app"), "read_thread") => "read_thread",
+            (None | Some("functions"), "mcp__codex_app__wait_threads")
+            | (Some("mcp__codex_app"), "wait_threads") => "wait_threads",
+            _ => return false,
+        };
+        if invocation.tool_name.clone().with_default_namespace()
+            != self.tool_name.clone().with_default_namespace()
+        {
+            return false;
+        }
+        bounded_desktop_read_allowed(capability, &invocation.payload)
+    }
+}
+
+// Shared with the host-attested desktop MCP runtime; this validates arguments, not provenance.
+pub(super) fn bounded_desktop_read_allowed(capability: &str, payload: &ToolPayload) -> bool {
+    let ToolPayload::Function { arguments } = payload else {
+        return false;
+    };
+    if arguments.len() > 16_384 {
+        return false;
+    }
+    let Ok(Value::Object(args)) = serde_json::from_str::<Value>(arguments) else {
+        return false;
+    };
+    match capability {
+        "read_thread" => {
+            only_fields(
+                &args,
+                &[
+                    "threadId",
+                    "hostId",
+                    "cursor",
+                    "turnLimit",
+                    "includeOutputs",
+                    "maxOutputCharsPerItem",
+                ],
+            ) && valid_thread(&args)
+                && optional_text(&args, "cursor", 2048)
+                && args
+                    .get("turnLimit")
+                    .and_then(Value::as_u64)
+                    .is_some_and(|n| (1..=5).contains(&n))
+                && args
+                    .get("maxOutputCharsPerItem")
+                    .and_then(Value::as_u64)
+                    .is_some_and(|n| n <= 8000)
+                && args.get("includeOutputs").is_none_or(Value::is_boolean)
+        }
+        "wait_threads" => {
+            only_fields(&args, &["targets", "timeoutMs"])
+                && args
+                    .get("timeoutMs")
+                    .and_then(Value::as_u64)
+                    .is_some_and(|n| n <= 60_000)
+                && args
+                    .get("targets")
+                    .and_then(Value::as_array)
+                    .is_some_and(|targets| {
+                        (1..=8).contains(&targets.len())
+                            && targets.iter().all(|target| {
+                                target.as_object().is_some_and(|target| {
+                                    only_fields(target, &["threadId", "hostId", "afterCursor"])
+                                        && valid_thread(target)
+                                        && optional_text(target, "afterCursor", 2048)
+                                })
+                            })
+                    })
+        }
+        _ => false,
+    }
+}
+
+fn only_fields(args: &serde_json::Map<String, Value>, fields: &[&str]) -> bool {
+    args.keys().all(|key| fields.contains(&key.as_str()))
+}
+
+fn optional_text(args: &serde_json::Map<String, Value>, key: &str, max: usize) -> bool {
+    args.get(key).is_none_or(|value| {
+        value.as_str().is_some_and(|text| {
+            !text.is_empty() && text.len() <= max && !text.chars().any(char::is_control)
+        })
+    })
+}
+
+fn valid_thread(args: &serde_json::Map<String, Value>) -> bool {
+    args.get("threadId")
+        .and_then(Value::as_str)
+        .is_some_and(|id| codex_protocol::ThreadId::from_string(id).is_ok())
+        && optional_text(args, "hostId", 128)
 }

