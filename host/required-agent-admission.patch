+impl CoreToolRuntime for PrepareAgentTaskHandler {}
+
+fn read_page(
+    text: &str,
+    offset: usize,
+    expected_hash: Option<&str>,
+) -> Result<Value, FunctionCallError> {
+    let hash = format!("{:x}", Sha256::digest(text.as_bytes()));
+    if expected_hash.is_some_and(|expected| expected != hash) {
+        return Err(error("read_only source changed; restart at offset 0"));
+    }
+    if offset > text.len()
+        || !text.is_char_boundary(offset)
+        || (offset > 0 && expected_hash.is_none())
+    {
+        return Err(error(
+            "read_only continuation requires a valid UTF-8 offset and sha256",
+        ));
+    }
+    let mut page = json!({
+        "data": "", "start_line": text[..offset].bytes().filter(|b| *b == b'\n').count() + 1,
+        "offset": offset, "next_offset": null, "sha256": hash,
+    });
+    let mut end = offset;
+    let mut lines = 0;
+    for (index, ch) in text[offset..].char_indices() {
+        let candidate = offset + index + ch.len_utf8();
+        page["data"] = json!(&text[offset..candidate]);
+        page["next_offset"] = if candidate < text.len() {
+            json!(candidate)
+        } else {
+            Value::Null
+        };
+        if page.to_string().len() > MAX_OUTPUT_BYTES {
+            break;
+        }
+        end = candidate;
+        if ch == '\n' {
+            lines += 1;
+            if lines == 200 {
+                break;
+            }
+        }
+    }
+    page["data"] = json!(&text[offset..end]);
+    page["next_offset"] = if end < text.len() {
+        json!(end)
+    } else {
