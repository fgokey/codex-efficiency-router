+async fn check_admitted_send(v2: bool) {
+    use codex_protocol::openai_models::ReasoningEffort;
+    let (home, mut config) = test_config().await;
+    let _ = config.features.enable(Feature::Collab);
+    if v2 {
+        let _ = config.features.enable(Feature::MultiAgentV2);
+    } else {
+        let _ = config.features.disable(Feature::MultiAgentV2);
+    }
+    config.model = Some("gpt-6.1-sol".to_string());
+    config.model_reasoning_effort = Some(ReasoningEffort::High);
+    let harness = AgentControlHarness::new_with_config(home, config).await;
+    let (parent_id, parent) = harness.start_thread().await;
+    let control = parent
+        .session
+        .services
+        .local_agent_runtime
+        .control(parent.session.session_id());
+    let child =
+        spawn_v2_reload_test_child(&control, harness.config.clone(), &parent, "admitted").await;
+    let make_request = |caller, model: &str, effort| crate::SendRequest {
+        admitted_identity: Some((model.to_string(), effort)),
+        parent_report: false,
+        caller,
+        target: crate::AgentTarget::Id(child.thread_id),
+        resume_config: harness.config.clone(),
+        input: AgentInput::Message {
+            message: AgentMessage::Plaintext("checked body".to_string()),
+            mode: MessageDeliveryMode::QueueOnly,
+        },
+        start_options: Default::default(),
+    };
+    for request in [
+        make_request(parent_id, "gpt-6-astra", ReasoningEffort::High),
+        make_request(parent_id, "gpt-6.1-sol", ReasoningEffort::Low),
+        make_request(child.thread_id, "gpt-6.1-sol", ReasoningEffort::High),
+    ] {
+        assert!(control.send(request).await.is_err());
+    }
+    control
+        .send(make_request(
+            parent_id,
+            "gpt-6.1-sol",
+            ReasoningEffort::High,
+        ))
+        .await
+        .expect("live exact recipient accepted");
+    let thread = harness
+        .manager
+        .remove_thread(&child.thread_id)
+        .await
+        .expect("remove child");
+    thread.shutdown_and_wait().await.expect("shutdown child");
+    assert!(
+        control
+            .send(make_request(
+                parent_id,
+                "gpt-6.1-sol",
+                ReasoningEffort::High
+            ))
+            .await
+            .is_err()
+    );
+    assert_thread_not_loaded(&harness.manager, child.thread_id).await;
+}
