+#[tokio::test]
+async fn parent_status_report_never_queues_or_reloads_an_evicted_parent() {
+    let (home, mut config) = test_config().await;
+    config.features.enable(Feature::MultiAgentV2).unwrap();
+    config.features.enable(Feature::Sqlite).unwrap();
+    config.multi_agent_v2.max_concurrent_threads_per_session = 4;
+    let harness = AgentControlHarness::new_with_config(home, config).await;
+    let (root_id, root) = harness.start_paginated_thread().await;
+    let control = root
+        .session
+        .services
+        .local_agent_runtime
+        .control(root.session.session_id());
+    let parent =
+        spawn_v2_reload_test_child(&control, harness.config.clone(), &root, "parent").await;
+    let parent_thread = harness.manager.get_thread(parent.thread_id).await.unwrap();
+    let child =
+        spawn_v2_reload_test_child(&control, harness.config.clone(), &parent_thread, "reporter")
+            .await;
+    let request = |target| crate::SendRequest {
+        admitted_identity: None,
+        parent_report: true,
+        caller: child.thread_id,
+        target: crate::AgentTarget::Id(target),
+        resume_config: harness.config.clone(),
+        input: AgentInput::Message {
+            message: AgentMessage::Plaintext("status evidence".to_string()),
+            mode: MessageDeliveryMode::QueueOnly,
+        },
+        start_options: Default::default(),
+    };
+    assert!(
+        control.send(request(root_id)).await.is_err(),
+        "a grandparent is not the direct parent"
+    );
+    parent_thread
+        .inject_response_items(vec![assistant_message(
+            "parent persisted",
+            Some(MessagePhase::FinalAnswer),
+        )])
+        .await
+        .unwrap();
+    // This production fixture has no task runner to finish the initial turn.
+    parent_thread.session.mark_interrupted();
+    *parent_thread.session.active_turn.lock().await = None;
+    assert_eq!(
+        harness
+            .manager
+            .try_evict_v2_thread(parent_thread)
+            .await
+            .unwrap(),
+        ThreadEvictionOutcome::Evicted
+    );
+    let before = harness.manager.captured_ops().len();
+    assert!(control.send(request(parent.thread_id)).await.is_err());
+    assert!(harness.manager.get_thread(parent.thread_id).await.is_err());
+    assert!(
+        control
+            .runtime
+            .registry
+            .evicted_environments(parent.thread_id)
+            .is_some()
+    );
+    assert_eq!(
+        harness.manager.captured_ops().len(),
+        before,
+        "report must not queue cold mail or resume work"
+    );
+}
