+// Drives native sampling -> finalization -> continuation with local response fixtures.
+// The receipt validates declared work; this fixture does not grade business semantics.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn parent_completion_missing_receipt_continues_the_native_turn() -> Result<()> {
+    use codex_core::TurnInputRequest;
+    use codex_protocol::protocol::EventMsg;
+    use codex_protocol::user_input::UserInput;
+    use core_test_support::wait_for_event;
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let responses = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("parent-begin"),
+                ev_function_call("parent-scope", "completion_check", r#"{"operation":"begin","accepted_scope":"Resolve the original ownership issue","required_work":[{"id":"ownership","requirement":"Close retained object ownership"}]}"#),
+                ev_completed("parent-begin"),
+            ]),
+            sse(vec![
+                ev_assistant_message("parent-partial", "Local copy fixes pass; the ownership issue is still actionable."),
+                ev_completed("parent-partial"),
+            ]),
+            sse(vec![
+                core_test_support::responses::ev_custom_tool_call("parent-receipt", "exec", &parent_check_script("done")),
+                ev_completed("parent-receipt"),
+            ]),
+            sse(vec![
+                ev_assistant_message("parent-complete", "Required ownership work is complete."),
+                ev_completed("parent-complete"),
+            ]),
+        ],
+    ).await;
+    let marker_root = TempDir::new()?;
+    let marker = marker_root.path().join("stop-hook-called");
+    let command = if cfg!(windows) {
+        format!(
+            "powershell.exe -NoProfile -NonInteractive -Command \"[IO.File]::WriteAllText('{}','called'); @{{continue=([bool]0)}} | ConvertTo-Json -Compress\"",
+            marker.display()
+        )
+    } else {
+        format!(
+            "printf called > '{}'; printf '%s' '{{\"continue\":false}}'",
+            marker.display()
+        )
+    };
+    let mut builder = test_codex()
+        .with_pre_build_hook(move |home| {
+            fs::write(
+                home.join("hooks.json"),
+                serde_json::json!({"hooks":{"Stop":[{"hooks":[{
+            "type":"command","command":command,"timeout":10}]}]}})
+                .to_string(),
+            )
+            .unwrap();
+        })
+        .with_config(|config| {
+            config.agent_admission_hook = Some("required-admission".to_string());
+            trust_discovered_hooks(config);
+            config.features.enable(Feature::CodeMode).unwrap();
+        });
+    let test = builder.build(&server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text:
+                "Resolve the ownership issue completely, including the remaining retained objects."
+                    .to_string(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let mut hook_results = Vec::new();
+    let mut native_errors = Vec::new();
+    loop {
+        match wait_for_event(&test.codex, |_| true).await {
+            EventMsg::HookCompleted(event) => {
+                hook_results.push(format!("{event:?}").chars().take(1200).collect::<String>());
+            }
+            EventMsg::Error(error) => {
+                native_errors.push(error.message);
+            }
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    assert_eq!(
+        responses.requests().len(),
+        4,
+        "an open parent objective must not end at the partial final"
+    );
+    assert!(
+        native_errors.is_empty(),
+        "native turn must complete successfully: {native_errors:?}"
+    );
+    let accepted = responses.requests()[3]
+        .custom_tool_call_output("parent-receipt")
+        .to_string();
+    assert!(
+        accepted.contains("\\\"accepted\\\":true"),
+        "fresh check must actually be accepted: {accepted}"
+    );
+    let config = test.codex.config().await;
+    let hooks_enabled = config.features.enabled(Feature::CodexHooks);
+    let configured_hooks = codex_hooks::list_hooks(codex_hooks::HooksConfig {
+        feature_enabled: hooks_enabled,
+        config_layer_stack: Some(config.config_layer_stack.clone()),
+        ..Default::default()
+    });
+    assert!(
+        marker.exists(),
+        "permissive Stop hook did not create the native fixture marker: enabled={hooks_enabled}, configured={:?}, results={hook_results:?}",
+        configured_hooks.hooks
+    );
+    assert_eq!(
+        fs::read_to_string(marker)?.trim(),
+        "called",
+        "the permissive external Stop hook must actually execute after the native gate"
+    );
+    Ok(())
+}
