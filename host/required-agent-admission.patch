+async fn parent_status_report_target(
+    sess: &Arc<Session>,
+    turn: &TurnContext,
+    name: &str,
+    input: &Value,
+) -> Option<codex_protocol::ThreadId> {
+    if !is_native_status_message(name) || turn.config.agent_admission_hook.is_none() {
+        return None;
+    }
+    let parent = turn.parent_thread_id?;
+    let Some(input) = input.as_object().filter(|input| input.len() == 2) else {
+        return None;
+    };
+    let (Some(target), Some(message)) = (
+        input.get("target").and_then(Value::as_str),
+        input.get("message").and_then(Value::as_str),
+    ) else {
+        return None;
+    };
+    if message.trim().is_empty() {
+        return None;
+    }
+    sess.services
+        .agent_control
+        .resolve(sess.thread_id, Some(parent), &turn.session_source, target)
+        .await
+        .ok()
+        .filter(|target| *target == parent)
+}
