+        let first = read_page(&text, 0, None).unwrap();
+        assert!(first.to_string().len() <= MAX_OUTPUT_BYTES);
+        assert!(first["data"].as_str().unwrap().lines().count() <= 200);
+        let offset = first["next_offset"].as_u64().unwrap() as usize;
