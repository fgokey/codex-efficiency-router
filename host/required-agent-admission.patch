+/// The required trusted hook runs the installed Reader's assignment preflight and
+/// injects its bounded result into context before this no-op handler can succeed.
+pub struct PrepareAgentTaskHandler;
+
+impl ToolExecutor<ToolInvocation> for PrepareAgentTaskHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("prepare_agent_task")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        let recipient = JsonSchema::object(
+            ["id", "model", "effort", "evidence_ref"]
+                .into_iter()
+                .map(|key| (key.to_string(), JsonSchema::string(None)))
+                .collect(),
+            Some(
+                ["id", "model", "effort", "evidence_ref"]
+                    .into_iter()
+                    .map(str::to_string)
+                    .collect(),
+            ),
+            Some(false.into()),
+        );
+        let signals = JsonSchema::object(
+            [
+                "spec_complete",
+                "authority_ready",
+                "environment_ready",
+                "observability_ready",
+            ]
+            .into_iter()
+            .map(|key| (key.to_string(), JsonSchema::boolean(None)))
+            .collect(),
+            Some(
+                [
+                    "spec_complete",
+                    "authority_ready",
+                    "environment_ready",
+                    "observability_ready",
+                ]
+                .into_iter()
+                .map(str::to_string)
+                .collect(),
+            ),
+            Some(true.into()),
+        );
+        let mut request: BTreeMap<_, _> = ["unit_id", "purpose", "scope", "message"]
+            .into_iter()
+            .map(|key| (key.to_string(), JsonSchema::string(None)))
+            .collect();
+        request.insert("recipient".to_string(), recipient);
+        request.insert("signals".to_string(), signals);
+        for key in ["complexity_reason", "effort_reason"] {
+            request.insert(key.to_string(), JsonSchema::string(None));
+        }
+        for key in ["confirmed_simple", "effort_supported"] {
+            request.insert(key.to_string(), JsonSchema::boolean(None));
+        }
+        ToolSpec::Function(ResponsesApiTool {
+            name: "prepare_agent_task".to_string(),
+            description: "Generate a fresh Reader assignment envelope through the configured mandatory trusted admission hook, without shell access. Pass the Reader assignment request object with unit_id, purpose=new_unit, scope, exact message, observed recipient and readiness signals. The hook adds the VERIFIED result, exact prefix and admitted_dispatch_arguments to context. Existing child IDs return assign. Exceptional Astra identity creation uses recipient id unbound-spawn and the fixed HOLD plus current complexity/Sol61-unsuitable reasons; the result returns spawn_hold without target. Add explicit task_name and agent_type, then pass prefix + the checked HOLD as body. Verify actual child identity before preparing a separate RELEASE assignment. This does not itself send work or grant write authority.".to_string(),
+            strict: false,
+            defer_loading: None,
+            parameters: JsonSchema::object(
+                BTreeMap::from([("request".to_string(), JsonSchema::object(request, Some(["unit_id", "purpose", "scope", "message", "recipient", "signals"].into_iter().map(str::to_string).collect()), Some(false.into())))]),
+                Some(vec!["request".to_string()]), Some(false.into()),
+            ),
+            output_schema: None,
+        })
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            if invocation
+                .turn
+                .config
+                .agent_admission_hook
+                .as_deref()
+                .is_none_or(str::is_empty)
+            {
+                return Err(error("Required agent admission hook is not configured"));
+            }
+            Ok(boxed_tool_output(FunctionToolOutput::from_text(
+                "Fresh Reader assignment accepted by the required trusted hook. Use its context result's prefix with the exact checked message; recipient evidence still requires parent verification and RELEASE.".to_string(), Some(true),
+            )))
+        })
+    }
+}
