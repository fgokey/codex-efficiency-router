+fn admission_execution_allowed(invocation: &ToolInvocation, tool: &dyn CoreToolRuntime) -> bool {
+    if invocation.turn.config.agent_admission_hook.is_none() {
+        return true;
+    }
+    // Use the host-captured step identity, including the origin retained by code-mode cells.
+    // Unknown/snapshot aliases require an explicit audited addition, never prefix matching.
+    if matches!(
+        invocation.step_context.settings.model_info.slug.as_str(),
+        "gpt-6.1-sol"
+            | "gpt-6-sol"
+            | "gpt-6-luna"
+            | "gpt-5.6-sol"
+            | "gpt-5.6-terra"
+            | "gpt-5.6-luna"
+    ) {
+        return true;
+    }
+    if tool.is_third_party_tool() {
+        return tool.allows_bounded_parent_read(invocation);
+    }
+    let name = &invocation.tool_name;
+    if name.is_default_namespace() {
+        return matches!(
+            name.name.as_str(),
+            "read_only"
+                | "view_image"
+                | "prepare_agent_task"
+                | "admitted_agent_task"
+                | "exec"
+                | "wait"
+                | "update_plan"
+                | "completion_check"
+                | "get_context_remaining"
+                | "tool_search"
+                | "request_user_input"
+                | "request_user_input_async"
+                | "send_message_to_user_async"
+                | "wait_agent"
+                | "list_agents"
+                | "interrupt_agent"
+                | "close_agent"
+                | "spawn_agent"
+                | "send_input"
+                | "send_message"
+                | "followup_task"
+                | "resume_agent"
+        );
+    }
+    match name.namespace.as_deref() {
+        Some("clock") => matches!(name.name.as_str(), "curr_time" | "sleep"),
+        Some("collaboration" | MULTI_AGENT_V1_NAMESPACE) => matches!(
+            name.name.as_str(),
+            "wait"
+                | "wait_agent"
+                | "list_agents"
+                | "interrupt_agent"
+                | "close_agent"
+                | "spawn_agent"
+                | "send_input"
+                | "send_message"
+                | "followup_task"
+                | "resume_agent"
+        ),
+        _ => false,
+    }
