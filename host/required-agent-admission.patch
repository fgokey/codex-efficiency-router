+}
+
+impl ToolExecutor<ToolInvocation> for Handler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("admitted_agent_task")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        let fields = [
+            (
+                "operation",
+                "spawn_hold or assign; every call requires the configured trusted admission hook",
+            ),
+            (
+                "body",
+                "For assign: exact plaintext task and fresh admission envelope. Ordinary Sol61/high spawn_hold body: HOLD. Report only your identity and working directory; do not use tools or accept work until RELEASE. Exceptional Astra spawn_hold first requires prepare_agent_task for recipient id unbound-spawn, explicit Astra model/effort, current complexity_reason and signals.sol61_unsuitable_reason with very_complex=true; use its exact returned prefix plus the fixed HOLD as body. Verify the resulting actual child binding, then prepare a separate assignment for its actual id.",
+            ),
+            (
+                "task_name",
+                "New child identifier matching [a-z][a-z0-9_]{0,63}, e.g. review_memory; no hyphens or path; only for spawn_hold. Its result includes host-observed binding model/effort/role/owner/permissions; verify before RELEASE without shell or full-log scans.",
+            ),
+            (
+                "target",
+                "Existing direct child id or task name; only for assign; no reload",
+            ),
+            (
+                "agent_type",
+                "Explicit role for spawn_hold; omit for assign",
+            ),
+            ("model", "Explicit admitted model; defaults to gpt-6.1-sol"),
+            (
+                "reasoning_effort",
+                "Admitted reasoning effort; defaults to high",
+            ),
+        ];
+        ToolSpec::Function(ResponsesApiTool {
+            name: "admitted_agent_task".to_string(),
+            description: "Submit an exact plaintext task to mandatory trusted admission, then dispatch through native agent control. First spawn_hold (Astra requires a fresh reasoned unbound-spawn envelope), verify identity, then prepare and assign a separate task to that actual child. Each preparation is single use in this loaded parent; prepare immediately before dispatch. Ordinary engineering and review default to gpt-6.1-sol/high. Invoke alone; in code mode emit only this result, with observational reads in separate calls. For tool discovery, emit matching ALL_TOOLS names only, never full descriptions. This does not change the parent model or weaken existing native collaboration hooks.".to_string(),
+            strict: false,
+            defer_loading: None,
+            parameters: JsonSchema::object(
+                fields.into_iter().map(|(key, desc)| (key.to_string(), JsonSchema::string(Some(desc.to_string())))).collect::<BTreeMap<_, _>>(),
+                Some(vec!["operation".to_string(), "body".to_string()]), Some(false.into())),
+            output_schema: None,
+        })
+    }
+
+    fn handle<'a>(&'a self, mut invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            if invocation
+                .turn
+                .config
+                .agent_admission_hook
+                .as_deref()
+                .is_none_or(str::is_empty)
+            {
+                return Err(FunctionCallError::RespondToModel(
+                    "Required agent admission hook is not configured".to_string(),
+                ));
+            }
+            let args: Args = parse_arguments(&function_arguments(invocation.payload.clone())?)?;
+            let model = args.model.unwrap_or_else(|| "gpt-6.1-sol".to_string());
+            let effort = args.reasoning_effort.unwrap_or(ReasoningEffort::High);
+            let (tool, input, recipient) = match args.operation.as_str() {
+                "spawn_hold"
+                    if args.target.is_none()
+                        && args.task_name.is_some()
+                        && args.agent_type.is_some() =>
+                {
+                    (
+                        HookToolName::spawn_agent(),
+                        json!({"message": args.body, "task_name": args.task_name,
+                        "agent_type": args.agent_type, "model": model,
+                        "reasoning_effort": effort, "fork_turns": "none"}),
+                        None,
+                    )
+                }
+                "assign"
+                    if args.target.is_some()
+                        && args.task_name.is_none()
+                        && args.agent_type.is_none() =>
+                {
+                    let id = resolve_agent_target(
+                        &invocation.session,
+                        &invocation.turn,
+                        args.target.as_deref().unwrap(),
+                    )
+                    .await?;
+                    (
+                        HookToolName::new("followup_task"),
+                        json!({"target": id.to_string(), "message": args.body}),
+                        Some(id),
+                    )
+                }
+                _ => {
+                    return Err(FunctionCallError::RespondToModel(
+                        "Invalid admitted task operation or operation-specific fields".to_string(),
+                    ));
+                }
+            };
+            match run_pre_tool_use_hooks(
+                &invocation.session,
+                &invocation.step_context,
+                invocation.call_id.clone(),
+                &tool,
+                &input,
+                /*admitted_dispatch*/ true,
+            )
+            .await
+            {
+                PreToolUseHookResult::Continue {
+                    updated_input: None,
+                } => {}
+                PreToolUseHookResult::Blocked(reason) => {
+                    return Err(FunctionCallError::RespondToModel(reason));
+                }
+                _ => {
+                    return Err(FunctionCallError::RespondToModel(
+                        "Admission may not rewrite the checked task".to_string(),
+                    ));
+                }
+            }
+            if (recipient.is_some()
+                || args.body
+                    != "HOLD. Report only your identity and working directory; do not use tools or accept work until RELEASE.")
+                && !invocation
+                    .session
+                    .consume_prepared_agent_task(&args.body)
+                    .await
+            {
+                return Err(FunctionCallError::RespondToModel(
+                    "Fresh unused native task preparation required; call prepare_agent_task for this exact dispatch".to_string(),
+                ));
+            }
+            invocation.source = ToolCallSource::DirectPlaintextMessage;
+            if let Some(id) = recipient {
+                let receipt = invocation
+                    .session
+                    .services
+                    .agent_control
+                    .send(SendRequest {
+                        admitted_identity: Some((model, effort)),
+                        parent_report: false,
+                        caller: invocation.session.thread_id,
+                        target: AgentTarget::Id(id),
+                        resume_config: build_agent_resume_config(&invocation.turn)
+                            .map_err(FunctionCallError::RespondToModel)?,
+                        input: AgentInput::Message {
+                            message: AgentMessage::Plaintext(args.body),
+                            mode: MessageDeliveryMode::TriggerTurn,
+                        },
+                        start_options: TurnStartOptions {
+                            parent_turn_id: Some(invocation.turn.sub_id.clone()),
+                            root_turn_id: invocation.turn.turn_metadata_state.root_turn_id(),
+                            turn_trigger: invocation
+                                .turn
+                                .turn_metadata_state
+                                .current_turn_trigger(),
+                            cyber_access_program: invocation.turn.cyber_access_program,
+                            ..Default::default()
+                        },
+                    })
+                    .await
+                    .map_err(|error| FunctionCallError::RespondToModel(error.to_string()))?;
+                Ok(boxed_tool_output(FunctionToolOutput::from_text(
+                    json!({"agent_id": id, "submission_id": receipt.submission_id}).to_string(),
+                    Some(true),
+                )))
+            } else {
+                // The checked envelope authorizes identity creation, never work for an
+                // unverified child. Admission and its single-use receipt were checked above.
+                let mut input = input;
+                input["message"] = json!(
+                    "HOLD. Report only your identity and working directory; do not use tools or accept work until RELEASE."
+                );
+                invocation.payload = ToolPayload::Function {
+                    arguments: input.to_string(),
+                };
+                super::spawn::Handler::default().handle(invocation).await
+            }
+        })
+    }
+}
+
+impl CoreToolRuntime for Handler {
+    // Admission runs on the final normalized native operation inside handle. No earlier hook
+    // can rewrite the plaintext body between that check and its native dispatch.
+    fn pre_tool_use_payload(&self, _: &ToolInvocation) -> Option<PreToolUsePayload> {
+        None
+    }
+}
