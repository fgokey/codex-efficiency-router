--- /dev/null
+++ b/codex-rs/core/src/tools/handlers/read_only.rs
@@ -0,0 +1,374 @@
+use crate::function_tool::FunctionCallError;
+use crate::tools::context::FunctionToolOutput;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolPayload;
+use crate::tools::context::boxed_tool_output;
+use crate::tools::handlers::parse_arguments;
+use crate::tools::handlers::resolve_tool_environment;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::ToolExecutor;
+use codex_exec_server::GetMetadataOptions;
+use codex_exec_server::ReadFileOptions;
+use codex_tools::JsonSchema;
+use codex_tools::ResponsesApiTool;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+
+const MAX_FILE_BYTES: usize = 16 * 1024 * 1024;
+const MAX_OUTPUT_BYTES: usize = 3072;
+
+pub struct ReadOnlyHandler;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ReadOnlyArgs {
+    path: String,
+    #[serde(default)]
+    offset: usize,
+    sha256: Option<String>,
+    environment_id: Option<String>,
+}
+
+fn error(message: impl Into<String>) -> FunctionCallError {
+    FunctionCallError::RespondToModel(message.into())
+}
+
+impl ToolExecutor<ToolInvocation> for ReadOnlyHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("read_only")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        let properties = BTreeMap::from([
+            ("path".to_string(), JsonSchema::string(Some("Literal file or directory path.".to_string()))),
+            ("offset".to_string(), JsonSchema::number(Some("Continuation offset returned by the previous page; default 0.".to_string()))),
+            ("sha256".to_string(), JsonSchema::string(Some("For continuation, pass the previous page's sha256; changed sources are rejected.".to_string()))),
+            ("environment_id".to_string(), JsonSchema::string(Some("Optional environment identifier.".to_string()))),
+        ]);
+        ToolSpec::Function(ResponsesApiTool {
+            name: "read_only".to_string(),
+            description: "Read one bounded UTF-8 file or directory page through the environment filesystem and its read permissions. No shell, interpreter, command execution or writes. Output is at most 3072 JSON bytes and 200 lines. Continue using next_offset and sha256; do not merge pages into full files.".to_string(),
+            strict: false,
+            defer_loading: None,
+            parameters: JsonSchema::object(properties, Some(vec!["path".to_string()]), Some(false.into())),
+            output_schema: None,
+        })
+    }
+
+    fn supports_parallel_tool_calls(&self) -> bool {
+        true
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let ToolPayload::Function { arguments } = invocation.payload else {
+                return Err(error("read_only requires structured function arguments"));
+            };
+            let args: ReadOnlyArgs = parse_arguments(&arguments)?;
+            if args.path.len() > 2048 {
+                return Err(error("read_only path exceeds 2048 bytes"));
+            }
+            let environment = resolve_tool_environment(
+                &invocation.step_context,
+                args.environment_id.as_deref(),
+                "read_only is unavailable in this session",
+            )?;
+            let path = environment
+                .cwd()
+                .join(&args.path)
+                .map_err(|e| error(e.to_string()))?;
+            let sandbox = environment.sandbox_context(None);
+            let fs = environment.environment.get_filesystem();
+            let metadata = fs
+                .get_metadata(&path, GetMetadataOptions::default(), Some(&sandbox))
+                .await
+                .map_err(|e| error(e.to_string()))?;
+            let text = if metadata.is_directory {
+                let mut entries = fs
+                    .read_directory(&path, Some(&sandbox))
+                    .await
+                    .map_err(|e| error(e.to_string()))?;
+                if entries.len() > 10_000 {
+                    return Err(error(
+                        "read_only directory exceeds 10000 entries; narrow the path",
+                    ));
+                }
+                entries.sort_by(|a, b| a.file_name.cmp(&b.file_name));
+                entries
+                    .into_iter()
+                    .map(|entry| {
+                        format!(
+                            "{}{}\n",
+                            entry.file_name,
+                            if entry.is_directory { "/" } else { "" }
+                        )
+                    })
+                    .collect::<String>()
+            } else if metadata.is_file && metadata.size <= MAX_FILE_BYTES as u64 {
+                let bytes = fs
+                    .read_file(&path, ReadFileOptions::default(), Some(&sandbox))
+                    .await
+                    .map_err(|e| error(e.to_string()))?;
+                if bytes.len() > MAX_FILE_BYTES {
+                    return Err(error(
+                        "read_only file grew beyond 16 MiB; narrow the source",
+                    ));
+                }
+                String::from_utf8(bytes).map_err(|_| error("read_only requires UTF-8 text"))?
+            } else {
+                return Err(error(
+                    "read_only requires a regular file up to 16 MiB or a directory",
+                ));
+            };
+            let page = read_page(&text, args.offset, args.sha256.as_deref())?;
+            Ok(boxed_tool_output(FunctionToolOutput::from_text(
+                page.to_string(),
+                Some(true),
+            )))
+        })
+    }
+}
