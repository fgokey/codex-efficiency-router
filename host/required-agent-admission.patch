+        let first = read_page(&text, 0, None).unwrap();
+        assert!(first.to_string().len() <= MAX_OUTPUT_BYTES);
+        assert!(first["data"].as_str().unwrap().lines().count() <= 200);
+        let offset = first["next_offset"].as_u64().unwrap() as usize;
+        let hash = first["sha256"].as_str().unwrap();
+        let second = read_page(&text, offset, Some(hash)).unwrap();
+        assert_eq!(second["offset"], offset);
+        assert!(read_page(&text, offset, None).is_err());
+        assert!(read_page("changed", offset, Some(hash)).is_err());
+        assert!(read_page(&text, 1, Some(hash)).is_err());
+        assert!(read_page(&text, text.len() + 1, Some(hash)).is_err());
+    }
