+                "*** Begin Patch\n*** Add File: {}\n+fixture written\n*** End Patch",
+                patched.display()
+            );
+            let responses = mount_sse_sequence(
+                &server,
+                vec![
+                    sse(vec![
+                        ev_response_created("boundary-1"),
+                        ev_function_call(
