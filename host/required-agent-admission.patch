+use std::collections::BTreeMap;
+
+/// Admitted work survives turns; a completion receipt never survives new evidence.
+/// Stored in existing harness history metadata, never in the model's prompt or goal store.
+#[derive(Clone, Default, Serialize, Deserialize)]
+pub(crate) struct ParentWorkState {
+    scope: String,
+    required: BTreeMap<String, String>,
+    task_revision: u64,
+    event_version: u64,
+    pending: BTreeMap<String, (String, JsonValue)>,
+    receipt: Option<(String, u64, u64, bool)>,
+    recovery_error: Option<String>,
+    #[serde(skip)]
+    pub(crate) dirty: bool,
+    #[serde(skip)]
+    denied_turn: String,
+    #[serde(skip)]
+    denials: u8,
+    #[serde(skip)]
+    independent_answer_turn: Option<(String, bool)>,
+}
+
+impl ParentWorkState {
+    pub(crate) fn tool_arguments(name: &str, arguments: &str) -> Result<JsonValue, String> {
+        if name == "update_plan" && arguments.len() > 131_072 {
+            return Err("update_plan input exceeds 131072 bytes; submit a bounded plan without dropping required work".to_string());
+        }
+        serde_json::from_str(arguments)
+            .map_err(|error| format!("invalid parent work tool arguments: {error}"))
+    }
+
+    pub(crate) fn active(&self) -> bool {
+        !self.required.is_empty() || self.recovery_error.is_some()
+    }
+
+    pub(crate) fn changed(&mut self) {
+        if let Some((_, allowed)) = &mut self.independent_answer_turn {
+            *allowed = false;
+        }
+        if self.active() {
+            self.event_version += 1;
+            self.receipt = None;
+            self.dirty = true;
+        }
+    }
+
+    pub(crate) fn start_user_turn(&mut self, turn_id: &str) {
+        let fresh = self.independent_answer_turn.as_ref().is_none_or(|(turn, _)| turn != turn_id);
+        self.changed();
+        if fresh {
+            self.independent_answer_turn = Some((turn_id.to_string(), true));
+        }
+    }
+
+    fn independent_answer_allowed(&self, turn_id: &str) -> bool {
+        self.independent_answer_turn.as_ref().is_some_and(|(turn, allowed)| turn == turn_id && *allowed)
+    }
+
+    pub(crate) fn tool_started(
+        &mut self,
+        id: &str,
+        name: &ToolName,
+        native: bool,
+        args: JsonValue,
+    ) -> Result<(), String> {
+        let native = native && name.is_default_namespace();
+        let control = native
+            && (name.name == "exec" || (name.name == "wait" && args.get("cell_id").is_some()));
+        let kind = if control {
+            "__wrapper"
+        } else if native {
+            name.name.as_str()
+        } else {
+            "__external"
+        };
+        if kind == "completion_check" {
+            self.receipt = None;
+            self.dirty = self.active();
+        } else if kind != "__wrapper" {
+            self.changed();
+        }
+        let captured = if matches!(kind, "admitted_agent_task" | "update_plan") {
+            if kind == "admitted_agent_task" {
+                serde_json::json!({"operation":args["operation"],"target":args["target"]})
+            } else {
+                let steps = args["plan"]
+                    .as_array()
+                    .ok_or("update_plan requires a plan array")?;
+                if steps.len() > 128 {
+                    return Err(
+                        "update_plan exceeds 128 required steps; no steps were accepted or dropped"
+                            .to_string(),
+                    );
+                }
+                for step in steps {
+                    if !step["step"]
+                        .as_str()
+                        .is_some_and(|text| !text.trim().is_empty() && text.len() <= 512)
+                    {
+                        return Err("each required plan step must contain 1..512 bytes; no steps were accepted or dropped".to_string());
+                    }
+                }
+                serde_json::json!({"plan":steps.iter().map(|step| serde_json::json!({"step":step["step"]})).collect::<Vec<_>>()})
+            }
+        } else {
+            JsonValue::Null
+        };
+        if self.pending.len() >= 128 || self.pending.contains_key(id) {
+            self.recovery_error = Some("too many concurrent parent tool calls".to_string());
+            self.dirty = true;
+            return Err(
+                "parent tool tracking limit or duplicate call id; existing work retained"
+                    .to_string(),
+            );
+        }
+        self.pending
+            .insert(id.to_string(), (kind.to_string(), captured));
+        Ok(())
+    }
+
+    pub(crate) fn tool_finished(&mut self, id: &str, success: bool) {
+        if let Some((name, args)) = self.pending.remove(id) {
+            if matches!(name.as_str(), "__wrapper" | "completion_check") {
+                return;
+            }
+            if success {
+                self.record_obligation(&name, &args);
+            }
+        }
+        self.changed();
+    }
+
+    fn record_obligation(&mut self, name: &str, args: &JsonValue) {
+        use sha2::{Digest, Sha256};
+        if name == "admitted_agent_task" && args["operation"] == "assign" {
+            self.require(
+                format!(
+                    "dispatch:{:x}",
+                    Sha256::digest(args["target"].to_string().as_bytes())
+                ),
+                format!("Reconcile admitted work for {}", args["target"]),
+            );
+        } else if name == "apply_patch" {
+            self.require(
+                "effect:engineering".to_string(),
+                "Reconcile the direct engineering changes and original objective".to_string(),
+            );
+        } else if name == "update_plan"
+            && let Some(steps) = args["plan"].as_array()
+        {
+            for step in steps {
+                if let Some(text) = step["step"].as_str() {
+                    self.require(
+                        format!("plan:{:x}", Sha256::digest(text.as_bytes())),
+                        text.to_string(),
+                    );
+                }
+            }
+        }
+    }
+
+    fn in_flight(&self) -> usize {
+        self.pending
+            .values()
+            .filter(|(name, _)| !matches!(name.as_str(), "__wrapper" | "completion_check"))
+            .count()
+    }
+
+    fn require(&mut self, id: String, requirement: String) {
+        if id.len() > 256 || (self.required.len() >= 128 && !self.required.contains_key(&id)) {
+            self.recovery_error = Some("parent work inventory exceeds 128 items".to_string());
+        } else if !self.required.contains_key(&id) {
+            self.required
+                .insert(id, requirement.chars().take(128).collect());
+            self.task_revision += 1;
+        }
+        self.changed();
+        self.dirty = true;
+    }
+
+    pub(crate) fn observe(&mut self, item: &codex_protocol::models::ResponseItem) {
+        // Tool execution is observed at the trusted runtime boundary, including Code Mode.
+        // History alone contains only its outer exec/wait wrapper and must not double count.
+        if let codex_protocol::models::ResponseItem::Message { role, .. } = item
+            && role == "user"
+        {
+            self.changed();
+        }
+    }
+
+    fn apply(&mut self, args: &JsonValue, turn_id: &str) -> Result<bool, String> {
+        let operation = args["operation"].as_str().unwrap_or("");
+        if let Some(scope) = args.get("turn_scope") {
+            self.receipt = None;
+            self.dirty = true;
+            if operation != "check" || scope.as_str() != Some("independent_answer") {
+                return Err("turn_scope must be independent_answer on inspect/check".to_string());
+            }
+        }
+        if matches!(operation, "begin" | "append") {
+            if operation == "begin" && self.active() && !self.scope.is_empty() {
+                return Err(
+                    "accepted scope already exists; reconcile it rather than replacing it"
+                        .to_string(),
+                );
+            }
+            let scope = if operation == "append" {
+                if self.scope.is_empty() {
+                    return Err("begin the original accepted scope first".to_string());
+                }
+                self.scope.as_str()
+            } else {
+                args["accepted_scope"]
+                    .as_str()
+                    .filter(|s| !s.trim().is_empty() && s.len() <= 4096)
+                    .ok_or("accepted_scope must contain the original accepted objective")?
+            };
+            let items = args["required_work"]
+                .as_array()
+                .filter(|v| !v.is_empty() && v.len() <= 128)
+                .ok_or("required_work must contain every required item (1..128)")?;
+            let mut work = BTreeMap::new();
+            for item in items {
+                let id = item["id"]
+                    .as_str()
+                    .filter(|s| !s.trim().is_empty() && s.len() <= 256)
+                    .ok_or("invalid work id")?;
+                let requirement = item["requirement"]
+                    .as_str()
+                    .filter(|s| !s.trim().is_empty() && s.len() <= 512)
+                    .ok_or("invalid requirement")?;
+                if work
+                    .insert(id.to_string(), requirement.to_string())
+                    .is_some()
+                {
+                    return Err("duplicate required work id".to_string());
+                }
+                if self
+                    .required
+                    .get(id)
+                    .is_some_and(|existing| existing != requirement)
+                {
+                    return Err(
+                        "an existing requirement cannot be replaced; append a new id".to_string(),
+                    );
+                }
+            }
+            if (self.required.len()
+                + work
+                    .keys()
+                    .filter(|id| !self.required.contains_key(*id))
+                    .count()
+                > 128)
+                || work.len() > 128
+            {
+                return Err("parent work inventory exceeds 128 items".to_string());
+            }
+            self.scope = scope.to_string();
+            self.required.extend(work);
+            self.task_revision += 1;
+            self.event_version += 1;
+            self.receipt = None;
+            if let Some((_, allowed)) = &mut self.independent_answer_turn {
+                *allowed = false;
+            }
+            self.dirty = true;
+            return Ok(false);
+        }
+        if operation != "check" {
+            return Err("operation must be inspect, begin, append or check; caller fields cannot replace or clear accepted work".to_string());
+        }
+        self.receipt = None;
+        self.dirty = true;
+        if self.in_flight() != 0 {
+            return Err(
+                "parent tools are still running; await their result/cancellation and reconcile it"
+                    .to_string(),
+            );
+        }
+        if self.recovery_error.is_some() || self.scope.is_empty() || !self.active() {
+            return Err(
+                "declare the original accepted scope and all required work with begin".to_string(),
+            );
+        }
+        if args["task_revision"].as_u64() != Some(self.task_revision)
+            || args["event_version"].as_u64() != Some(self.event_version)
+        {
+            return Err("stale completion check; inspect current task/event versions".to_string());
+        }
+        if args["turn_scope"] == "independent_answer" {
+            if !self.independent_answer_allowed(turn_id) {
+                return Err("new evidence or engineering work requires full reconciliation".to_string());
+            }
+            if args.get("work").is_some()
+                || args.get("accepted_scope").is_some()
+                || args.get("required_work").is_some()
+                || !args["rationale"].as_str().is_some_and(|reason| {
+                    !reason.trim().is_empty() && reason.len() <= 1024
+                })
+            {
+                return Err("independent_answer needs a bounded rationale and cannot change retained work".to_string());
+            }
+            self.receipt = Some((
+                turn_id.to_string(),
+                self.task_revision,
+                self.event_version,
+                true,
+            ));
+            return Ok(false);
+        }
+        let work = args["work"]
+            .as_array()
+            .ok_or("work must reconcile every required id")?;
+        let mut seen = std::collections::BTreeSet::new();
+        let mut blocked = false;
+        for item in work {
+            let id = item["id"].as_str().ok_or("missing required id")?;
+            if !self.required.contains_key(id) || !seen.insert(id) {
+                return Err("unknown or duplicate required id".to_string());
+            }
+            if !item["evidence"]
+                .as_str()
+                .is_some_and(|s| !s.trim().is_empty() && s.len() <= 2048)
+            {
+                return Err("current evidence is required for every item".to_string());
+            }
+            match item["status"].as_str() {
+                Some("done") => {}
+                Some("external_block") => {
+                    for field in ["missing_resource", "affected_scope", "external_action"] {
+                        if !item[field]
+                            .as_str()
+                            .is_some_and(|s| !s.trim().is_empty() && s.len() <= 2048)
+                        {
+                            return Err(format!("external_block requires {field}"));
+                        }
+                    }
+                    blocked = true;
+                }
+                Some("actionable") => {
+                    return Err("authorized actionable work remains; continue it".to_string());
+                }
+                _ => return Err("status must be done, actionable or external_block".to_string()),
+            }
+        }
+        if seen.len() != self.required.len() {
+            return Err("required work omitted; inspect the retained inventory".to_string());
+        }
+        self.receipt = Some((
+            turn_id.to_string(),
+            self.task_revision,
+            self.event_version,
+            blocked,
+        ));
+        self.dirty = true;
+        Ok(!blocked)
+    }
+
+    pub(crate) fn receipt_current(&self, turn_id: &str) -> bool {
+        self.receipt.as_ref().is_some_and(|(turn, task, event, _)| {
+            turn == turn_id && *task == self.task_revision && *event == self.event_version
+        }) && self.recovery_error.is_none()
+            && self.in_flight() == 0
+    }
+
+    pub(crate) fn stop(&mut self, turn_id: &str) -> Result<Option<String>, String> {
+        if !self.active() || self.receipt_current(turn_id) {
+            return Ok(None);
+        }
+        if self.denied_turn != turn_id {
+            self.denied_turn = turn_id.to_string();
+            self.denials = 0;
+        }
+        self.denials += 1;
+        if self.denials > 2 {
+            return Err("Parent completion protocol failed twice; unresolved work retained. This is a lifecycle failure, not successful completion.".to_string());
+        }
+        Ok(Some("Parent engineering work is still open. Call completion_check inspect, reconcile the original accepted scope and every required item, then submit a fresh check. Continue any authorized actionable work. Local child PASS/tests do not close the objective. Never fabricate user cancellation, goals, external blocks or budget limits.".to_string()))
+    }
+
+    pub(crate) fn finish(&mut self, turn_id: &str) -> Result<(), String> {
+        if !self.active() {
+            return Ok(());
+        }
+        if !self.receipt_current(turn_id) {
+            return Err(
+                "Parent completion receipt changed before finalization; unresolved work retained"
+                    .to_string(),
+            );
+        }
+        if let Some((_, allowed)) = &mut self.independent_answer_turn {
+            *allowed = false;
+        }
+        if self.receipt.as_ref().is_some_and(|r| !r.3) {
+            self.scope.clear();
+            self.required.clear();
+            self.receipt = None;
+            self.dirty = true;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn restore(&mut self, snapshot: JsonValue) {
+        let restored = (snapshot["format_version"] == 1)
+            .then(|| serde_json::from_value(snapshot["state"].clone()));
+        *self = restored.and_then(Result::ok).unwrap_or_else(|| Self {
+            recovery_error: Some(
+                "invalid parent work checkpoint; cannot declare completion".to_string(),
+            ),
+            ..Self::default()
+        });
+        // Retained-work receipts cannot finalize a resumed turn, including an
+        // independent answer. All-done receipts remain for terminal replay.
+        if self.receipt.as_ref().is_some_and(|receipt| receipt.3) {
+            self.receipt = None;
+        }
+        // An old process cannot deliver these callbacks. Retain known work and
+        // require fresh reconciliation instead of leaving a permanent busy flag.
+        let interrupted = std::mem::take(&mut self.pending);
+        let had_pending = !interrupted.is_empty();
+        for (_, (name, args)) in interrupted {
+            self.record_obligation(&name, &args);
+        }
+        if had_pending {
+            self.changed();
+        }
+    }
+
+    pub(crate) fn checkpoint(&self) -> JsonValue {
+        serde_json::json!({"format_version":1,"state":self})
+    }
+
+    fn inspect(&self, args: &JsonValue, turn_id: &str) -> Result<JsonValue, String> {
+        use sha2::{Digest, Sha256};
+        if let Some(scope) = args.get("turn_scope") {
+            if scope.as_str() != Some("independent_answer") || args.get("offset").is_some() {
+                return Err("independent_answer inspection has no inventory cursor".to_string());
+            }
+            return Ok(serde_json::json!({"task_revision":self.task_revision,
+                "event_version":self.event_version,"retained_required_count":self.required.len(),
+                "independent_answer_allowed":self.independent_answer_allowed(turn_id) && self.active() && !self.scope.is_empty()
+                    && self.recovery_error.is_none() && self.in_flight() == 0,
+                "in_flight":self.in_flight(),"recovery_error":self.recovery_error}));
+        }
+        let offset = match args.get("offset") {
+            None => 0,
+            Some(value) => value
+                .as_u64()
+                .and_then(|v| usize::try_from(v).ok())
+                .ok_or("offset must be a nonnegative integer")?,
+        };
+        if offset > self.required.len()
+            || (offset > 0
+                && (args["task_revision"].as_u64() != Some(self.task_revision)
+                    || args["event_version"].as_u64() != Some(self.event_version)))
+        {
+            return Err("stale/invalid inventory continuation; inspect from offset 0".to_string());
+        }
+        let mut page = serde_json::json!({"task_revision":self.task_revision,"event_version":self.event_version,
+            "accepted_scope_summary":self.scope.chars().take(128).collect::<String>(),
+            "scope_truncated":self.scope.chars().count()>128,"scope_bytes":self.scope.len(),
+            "scope_sha256":format!("{:x}",Sha256::digest(self.scope.as_bytes())),
+            "offset":offset,"total":self.required.len(),"next_offset":null,"complete":true,
+            "required_work":{},"in_flight":self.in_flight(),"recovery_error":self.recovery_error});
+        let mut count = 0;
+        for (id, requirement) in self.required.iter().skip(offset) {
+            page["required_work"][id] = JsonValue::String(requirement.clone());
+            if page.to_string().len() > 2500 {
+                page["required_work"]
+                    .as_object_mut()
+                    .expect("work object")
+                    .remove(id);
+                break;
+            }
+            count += 1;
+            if count == 8 {
+                break;
+            }
+        }
+        if offset + count < self.required.len() {
+            if count == 0 {
+                return Err("one required item exceeds the bounded inspection output".to_string());
+            }
+            page["next_offset"] = (offset + count).into();
+            page["complete"] = false.into();
+        }
+        Ok(page)
+    }
+
+    pub(crate) fn request(&mut self, args: &JsonValue, turn_id: &str) -> JsonValue {
+        if args["operation"] == "inspect" {
+            self.inspect(args, turn_id)
+                .unwrap_or_else(|reason| serde_json::json!({"accepted":false,"reason":reason}))
+        } else {
+            match self.apply(args, turn_id) {
+                Ok(_) => {
+                    let mut result = serde_json::json!({"native_parent_completion":1,"accepted":true,"turn_id":turn_id,
+                        "task_revision":self.task_revision,"event_version":self.event_version});
+                    if args["turn_scope"] == "independent_answer" {
+                        result["objective_completed"] = false.into();
+                        result["retained_required_count"] = self.required.len().into();
+                    }
+                    result
+                }
+                Err(reason) => {
+                    serde_json::json!({"native_parent_completion":1,"accepted":false,"reason":reason})
+                }
+            }
+        }
+    }
+}
+
+pub struct CompletionCheckHandler;
+
+impl ToolExecutor<ToolInvocation> for CompletionCheckHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain("completion_check")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        use codex_tools::{JsonSchema, ResponsesApiTool};
+        let properties = ["operation", "accepted_scope", "turn_scope", "rationale"]
+            .into_iter()
+            .map(|name| (name.to_string(), JsonSchema::string(None)))
+            .chain(
+                ["task_revision", "event_version", "offset"]
+                    .into_iter()
+                    .map(|name| (name.to_string(), JsonSchema::number(None))),
+            )
+            .chain(["required_work", "work"].into_iter().map(|name| {
+                (
+                    name.to_string(),
+                    JsonSchema::array(
+                        JsonSchema::object(BTreeMap::new(), None, Some(true.into())),
+                        None,
+                    ),
+                )
+            }))
+            .collect();
+        ToolSpec::Function(ResponsesApiTool {
+            name: "completion_check".to_string(),
+            description: "Native parent finalization check, not a goal or proof of correctness. Invoke alone. No retained engineering work: no check or dummy scope. inspect pages retained work and task/event versions; follow next_offset with those versions. begin records original accepted_scope and required_work [{id,requirement}]; append only adds work. check needs current task_revision/event_version and every work [{id,status:done|actionable|external_block,evidence}]. external_block also needs missing_resource,affected_scope,external_action; finish unaffected work. Only for an independent current question WITH retained work, use turn_scope:independent_answer on compact inspect/check, current versions plus check rationale (1..1024 UTF-8 bytes), without work. All requirements remain; objective_completed=false. The model judges independence; continued engineering cannot use this scope. Engineering/new evidence disables it; input/results invalidate receipts; restart discards it. No caller clear/shrink/cancellation/budget exemption; native lifecycle owns exits.".to_string(),
+            strict: false, defer_loading: None,
+            parameters: JsonSchema::object(properties, Some(vec!["operation".to_string()]), Some(false.into())),
+            output_schema: None,
+        })
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let ToolPayload::Function { arguments } = invocation.payload else {
+                return Err(FunctionCallError::RespondToModel(
+                    "completion_check requires function arguments".to_string(),
+                ));
+            };
+            if arguments.len() > 32768 {
+                return Err(FunctionCallError::RespondToModel(
+                    "completion check exceeds 32768 bytes".to_string(),
+                ));
+            }
+            let args: JsonValue = crate::tools::handlers::parse_arguments(&arguments)?;
+            let result = invocation
+                .session
+                .parent_completion_request(&args, &invocation.turn.sub_id)
+                .await;
+            Ok(boxed_tool_output(
+                crate::tools::context::FunctionToolOutput::from_text(
+                    result.to_string(),
+                    Some(true),
+                ),
+            ))
+        })
+    }
+}
+
+impl CoreToolRuntime for CompletionCheckHandler {
+    fn is_builtin_control_tool(&self) -> bool {
+        true
+    }
+}

 pub struct PlanHandler;
