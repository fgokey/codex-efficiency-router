+                        ),
+                        ev_apply_patch_custom_tool_call("boundary-patch", &patch),
+                        ev_function_call(
+                            "boundary-stdin",
+                            "write_stdin",
+                            r#"{"session_id":123456,"chars":"write"}"#,
+                        ),
+                        ev_function_call(
+                            "boundary-read",
+                            "read_only",
+                            &serde_json::json!({"path": source}).to_string(),
+                        ),
+                        ev_completed("boundary-1"),
+                    ]),
