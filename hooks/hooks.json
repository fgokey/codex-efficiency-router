{
  "description": "Explicit native write guardrail; review /hooks before use.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT}/hooks/astra_write_guard.py\" --expected-bundle b9aa4c1acf18ed7fbfb728bc176d69c87f025a44204219689f7c87d8a56558c5",
            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle b9aa4c1acf18ed7fbfb728bc176d69c87f025a44204219689f7c87d8a56558c5",
            "timeout": 5,
            "statusMessage": "CER 0.7.0-rc.7 strict Astra write boundary"
          }
        ]
      }
    ]
  }
}
