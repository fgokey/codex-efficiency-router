{
  "description": "Explicit native write guardrail; review /hooks before use.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT}/hooks/astra_write_guard.py\" --expected-bundle 0afc5d3ab7ff02336ecd83e07cea196fcbe5cb154bde16d02652e0357e4d7f3b",
            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle 0afc5d3ab7ff02336ecd83e07cea196fcbe5cb154bde16d02652e0357e4d7f3b",
            "timeout": 5,
            "statusMessage": "CER 0.7.0 strict Astra write boundary"
          }
        ]
      }
    ]
  }
}
