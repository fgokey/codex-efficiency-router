      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT}/hooks/astra_write_guard.py\" --expected-bundle b30d0c8a5f9e2dddfb571b43b5d8e63e2c66d67bda16281c885dfb33ffae6dbf",
            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle b30d0c8a5f9e2dddfb571b43b5d8e63e2c66d67bda16281c885dfb33ffae6dbf",
            "timeout": 5,
            "statusMessage": "CER 0.8.3 strict Astra write boundary"
          }
        ]
      }
    ]
  }
}
