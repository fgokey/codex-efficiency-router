      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT}/hooks/astra_write_guard.py\" --expected-bundle 2b6458d5465abc71fd1528689fe6acd74667cf162504bf1513e5e975867dcd76",
            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle 2b6458d5465abc71fd1528689fe6acd74667cf162504bf1513e5e975867dcd76",
            "timeout": 5,
            "statusMessage": "CER 0.7.0-rc.5 strict Astra write boundary"
          }
        ]
      }
    ]
  }
}
