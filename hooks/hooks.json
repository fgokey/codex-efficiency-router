            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle 868914cbb33cd3c7e82e89593b6d3cb1eab8bc6d9cf51e43d879e48bfc1f5ffe",
            "timeout": 5,
            "statusMessage": "CER 0.8.2 strict Astra write boundary"
          }
        ]
      }
    ]
  }
}
