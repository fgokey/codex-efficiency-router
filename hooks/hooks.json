{
  "description": "Explicit native write guardrail; review /hooks before use.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT}/hooks/astra_write_guard.py\" --expected-bundle 203e948088e63be8678ead052cd4b2c60a80e4aa907d02ca34283de500518dc5",
            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle 203e948088e63be8678ead052cd4b2c60a80e4aa907d02ca34283de500518dc5",
            "timeout": 5,
            "statusMessage": "CER 0.8.0 strict Astra write boundary"
          }
        ]
      }
    ]
  }
}
