            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle c0a105e7e0a768d7d310d762efb6102f13b1d40803b55dad200390c455c08b5b",
            "timeout": 5,
            "statusMessage": "CER 0.7.0-rc.4 Astra write boundary"
          }
        ]
      }
    ]
  }
}
