{
  "description": "Explicit native write guardrail; review /hooks before use.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT}/hooks/astra_write_guard.py\" --expected-bundle 00df1bd4cccf5d4cc32aec0dbb85be47be9c2a0b721ced6f75ae121fcf8a8fa4",
            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle 00df1bd4cccf5d4cc32aec0dbb85be47be9c2a0b721ced6f75ae121fcf8a8fa4",
            "timeout": 5,
            "statusMessage": "CER 0.8.5 strict Astra write boundary"
          }
        ]
      }
    ]
  }
}
