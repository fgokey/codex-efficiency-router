            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle fad7e0c451a89325a5815e162337c588906589884c705179d8ba20231394e6e9",
            "timeout": 5,
            "statusMessage": "CER 0.8.6 strict Astra write boundary"
          }
        ]
      }
    ]
  }
}
