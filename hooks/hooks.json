            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle 7799d516cc9b55e0394a7badc07f7b3ad59155627729f18dd42bac6e84b43147",
            "timeout": 5,
            "statusMessage": "CER 0.7.0-rc.6 strict Astra write boundary"
