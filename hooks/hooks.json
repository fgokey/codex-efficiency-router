            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle a119c2a480d52a610f9e379ee9393c1873e1e95440f19ff88db5dbd5d0cc2abe",
            "timeout": 5,
