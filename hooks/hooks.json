            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle c4e400fadc05045e3c4a16b7f6033c5780f1920a794a9ac61efea61e875d50b2",
            "timeout": 5,
