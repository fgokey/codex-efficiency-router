{
  "description": "Explicit native write guardrail; review /hooks before use.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT}/hooks/astra_write_guard.py\" --expected-bundle 2cb44ab1a878a7f6634abbe9556eb64b5796c011c025561c2d98c570e82f304c",
            "commandWindows": "python -I -B \"$env:PLUGIN_ROOT/hooks/astra_write_guard.py\" --expected-bundle 2cb44ab1a878a7f6634abbe9556eb64b5796c011c025561c2d98c570e82f304c",
            "timeout": 5,
            "statusMessage": "CER 0.7.0-rc.15 strict Astra write boundary"
          }
        ]
      }
    ]
  }
}
